Cell[BoxData[
 RowBox[{
  RowBox[{"EEgfun", "[", 
   RowBox[{"a_", ",", "p_", ",", "e_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"p", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"a", "^", "2"}]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"e", "^", "2"}]}], ")"}], "^", "2"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "5"}], "+", 
            RowBox[{"e", "^", "2"}], "+", 
            RowBox[{"3", "p"}]}], ")"}]}], "+", 
         RowBox[{"p", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", 
             RowBox[{"e", "^", "4"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "3"}], "+", "p"}], ")"}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"p", "-", "2"}], ")"}], "^", "2"}]}], "-", 
            RowBox[{
             RowBox[{"e", "^", "2"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "8"}], "+", 
               RowBox[{"p", "^", "2"}]}], ")"}]}]}], ")"}]}]}], ")"}]}], "-", 
      
      RowBox[{"2", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"e", "^", "2"}]}], ")"}], "^", "2"}], "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"a", "^", "2"}], "*", "p", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "^", "2"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "e"}], ")"}], "^", "2"}]}], "+", 
           RowBox[{"p", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "-", 
              RowBox[{"2", "e"}], "+", "p"}], ")"}]}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "^", "2"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "e"}], ")"}], "^", "2"}]}], "+", 
           RowBox[{"p", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "+", 
              RowBox[{"2", "e"}], "+", "p"}], ")"}]}]}], ")"}]}], "]"}], 
       RowBox[{"RealSign", "[", "x", "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"p", "^", "2"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "4"}], 
         RowBox[{"a", "^", "2"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"e", "^", "2"}]}], ")"}], "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", "+", 
            RowBox[{"e", "^", "2"}], "-", "p"}], ")"}], "^", "2"}], "*", 
         "p"}]}], ")"}]}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.985341225914988*^9, 3.985341229803061*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"451a034a-bc85-448f-8509-bfc42d12fa9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Lzgfun", "[", 
   RowBox[{"a_", ",", "p_", ",", "e_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r1g", ",", "r2g", ",", "EEg", ",", "Lzgzaux", ",", "ddinc", ",", 
      "ffinc", ",", "gginc", ",", "hhinc"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"r1g", "=", 
      RowBox[{"p", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"r2g", "=", 
      RowBox[{"p", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "e"}], ")"}]}]}], ";", "\n", "\n", "\t", 
     RowBox[{"EEg", "=", 
      RowBox[{"EEgfun", "[", 
       RowBox[{"a", ",", "p", ",", "e", ",", "x"}], "]"}]}], ";", "\n", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"ddinc", "[", "r_", "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "^", "2"}], "-", 
         RowBox[{"2", "r"}], "+", 
         RowBox[{"a", "^", "2"}]}], ")"}], 
       RowBox[{"r", "^", "2"}]}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"ffinc", "[", "r_", "]"}], ":=", 
      RowBox[{
       RowBox[{"r", "^", "4"}], "+", 
       RowBox[{
        RowBox[{"a", "^", "2"}], 
        RowBox[{"(", 
         RowBox[{"r", "+", "2"}], ")"}], "r"}]}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"gginc", "[", "r_", "]"}], ":=", 
      RowBox[{"2", " ", "a", " ", "r"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"hhinc", "[", "r_", "]"}], ":=", 
      RowBox[{"r", 
       RowBox[{"(", 
        RowBox[{"r", "-", "2"}], ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"Lzgzaux", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"gginc", "[", "r2g", "]"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"hhinc", "[", "r2g", "]"}], 
            RowBox[{"ffinc", "[", "r2g", "]"}]}]}], ")"}], 
         RowBox[{"EEg", "^", "2"}]}], "-", 
        RowBox[{
         RowBox[{"hhinc", "[", "r2g", "]"}], 
         RowBox[{"ddinc", "[", "r2g", "]"}]}]}], "]"}]}], ";", "\n", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"gginc", "[", "r2g", "]"}]}], " ", "EEg"}], "+", 
        RowBox[{
         RowBox[{"RealSign", "[", "x", "]"}], "*", "Lzgzaux"}]}], ")"}], "/", 
      
      RowBox[{"hhinc", "[", "r2g", "]"}]}]}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.985341232483098*^9, 3.985341236769862*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"6bac8b1f-dbdd-46b2-87cb-e0a79c771379"]
}, Closed]],

