Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalUpsilon]rgfunCoM", "[", "EEg_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r3g", ",", "krg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r3g", "=", 
      RowBox[{
       RowBox[{"2", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"EEg", "^", "2"}]}], ")"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"r1g", "+", "r2g"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"krg", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r1g", "-", "r2g"}], ")"}], "r3g"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r1g", "-", "r3g"}], ")"}], "r2g"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Pi]", "/", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"EllipticK", "[", "krg", "]"}]}], ")"}]}], " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"EEg", "^", "2"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"r1g", "-", "r3g"}], ")"}], "r2g"}], "]"}]}]}]}], "\n", 
   "]"}]}]], "Input",
