 RowBox[{
  FractionBox[
   RowBox[{"\[PartialD]", 
    SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
   RowBox[{"\[PartialD]", "e"}]], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["r", 
        RowBox[{"1", "g"}]]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["r", 
        RowBox[{"1", "g"}]]}], 
      RowBox[{"\[PartialD]", "e"}]]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["r", 
        RowBox[{"2", "g"}]]}]], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["r", 
