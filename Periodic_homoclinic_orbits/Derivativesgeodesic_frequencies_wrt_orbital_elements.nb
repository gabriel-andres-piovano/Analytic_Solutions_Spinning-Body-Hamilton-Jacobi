Cell["\<\
The notebook presents the derivatives of the geodesic Mino-time and BL \
frequencies on the equatorial plane with respect to the constants of motion, \
radial turning points or (p,e).\
\>", "Text",
 CellChangeTimes->{{3.986102670180024*^9, 
  3.9861027731466093`*^9}},ExpressionUUID->"16e6e77a-2cff-4898-9645-\
61e7d720f174"],

