Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalUpsilon]tgrfunCoM", "[", 
   RowBox[{"EEg_", ",", "Lzg_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r3g", ",", "krg", ",", "ellK", ",", "hr", ",", "hp", ",", "hm"}], "}"}],
     ",", "\n", "\t", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"r1g", "=", 
       RowBox[{"p", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "e"}], ")"}]}]}], ";", "\n", "\t", 
      RowBox[{"r2g", "=", 
       RowBox[{"p", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "e"}], ")"}]}]}], ";"}], "*)"}], "\n", "\t", 
    RowBox[{
     RowBox[{"r3g", "=", 
      RowBox[{
       RowBox[{"2", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"EEg", "^", "2"}]}], ")"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"r1g", "+", "r2g"}], ")"}]}]}], ";", "\n", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"rp", "=", 
        RowBox[{"1", "+", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"a", "^", "2"}]}], "]"}]}]}], ";", "\n", "\t", 
       RowBox[{"rm", "=", 
        RowBox[{"1", "-", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"a", "^", "2"}]}], "]"}]}]}], ";"}], "*)"}], "\n", "\n", 
     "\t", 
     RowBox[{"krg", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r1g", "-", "r2g"}], ")"}], "r3g"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r1g", "-", "r3g"}], ")"}], "r2g"}], ")"}]}]}], ";", "\n", 
     "\t", 
     RowBox[{"ellK", "=", 
      RowBox[{"EllipticK", "[", "krg", "]"}]}], ";", "\n", "\t", 
     RowBox[{"hr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r1g", "-", "r2g"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"r1g", "-", "r3g"}], ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"hp", "=", 
      RowBox[{"hr", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r3g", "-", "rp"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"r2g", "-", "rp"}], ")"}]}]}]}], ";", "\n", "\t", 
     RowBox[{"hm", "=", 
      RowBox[{"hr", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r3g", "-", "rm"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"r2g", "-", "rm"}], ")"}]}]}]}], ";", "\n", "\n", "\t", 
