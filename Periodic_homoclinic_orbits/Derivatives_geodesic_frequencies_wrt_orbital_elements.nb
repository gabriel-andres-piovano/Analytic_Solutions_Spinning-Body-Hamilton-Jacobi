 CellLabel->"Out[22]=",ExpressionUUID->"c2423e54-ec5a-421f-a972-c5b95da2c33e"]
}, Open  ]],

Cell[TextData[{
 "The derivatives of the BL  time frequencies can be written in terms of the \
derivatives of the Mino-time frequencies. Moreover, it is more convenient to \
compute the derivatives wrt constants of motion, and apply the chain rule to \
obtain derivatives of the frequencies wrt to other variables (like the radial \
potential roots  (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"1", "g"}]], ",", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "c0d32b54-3eb6-4b62-8e97-715c02b281c0"],
 ") and (p,e) )."
}], "Text",
 CellChangeTimes->{{3.984800069050816*^9, 3.984800091002454*^9}, {
   3.984800148334741*^9, 3.984800250495447*^9}, {3.984800301186901*^9, 
   3.9848003513581657`*^9}, {3.984801394925562*^9, 3.9848013985858297`*^9}, {
   3.985341002415121*^9, 3.985341006234983*^9}, {3.985341119047091*^9, 
   3.985341136208568*^9}, 3.985341607918571*^9, {3.986102796940324*^9, 
   3.98610280087659*^9}},ExpressionUUID->"3b1848f8-4b7d-48ff-a90d-\
30b9ffd9a1ca"],

Cell[BoxData[{
 RowBox[{
  FractionBox[
   SubscriptBox["d\[CapitalUpsilon]", "ig"], 
   SubscriptBox["dr", 
    RowBox[{"1", "g"}]]], "=", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["E", "g"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["E", "g"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["r", 
       RowBox[{"1", "g"}]]}]]}], "+", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["L", "zg"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["L", "zg"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["r", 
       RowBox[{"1", "g"}]]}]]}], "+", 
   FractionBox[
    RowBox[{"\[PartialD]", 
     SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
    RowBox[{"\[PartialD]", 
     SubscriptBox["r", 
      RowBox[{"1", "g"}]]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  FractionBox[
   SubscriptBox["d\[CapitalUpsilon]", "ig"], 
   SubscriptBox["dr", 
    RowBox[{"2", "g"}]]], "=", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["E", "g"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["E", "g"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["r", 
       RowBox[{"2", "g"}]]}]]}], "+", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["L", "zg"]}]], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      SubscriptBox["L", "zg"]}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["r", 
       RowBox[{"2", "g"}]]}]]}], "+", 
   FractionBox[
    RowBox[{"\[PartialD]", 
     SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
    RowBox[{"\[PartialD]", 
     SubscriptBox["r", 
      RowBox[{"2", "g"}]]}]]}]}]}], "DisplayFormula",
 CellChangeTimes->{{3.984800390244301*^9, 3.984800390366057*^9}, {
