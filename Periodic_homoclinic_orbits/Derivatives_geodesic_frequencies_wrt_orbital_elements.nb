   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["r", 
        RowBox[{"1", "g"}]]}]], 
     FractionBox["1", 
      RowBox[{"1", "-", "e"}]]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
