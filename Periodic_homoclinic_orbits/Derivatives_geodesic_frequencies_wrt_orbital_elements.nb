  3.984800091002454*^9}},ExpressionUUID->"31fdc63a-8059-4fc0-957e-\
09daef5ebcdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"\[CapitalUpsilon]ig", "[", "y", "]"}], 
      RowBox[{"\[CapitalUpsilon]tg", "[", "y", "]"}]], ",", "y"}], "]"}], "/.", 
   RowBox[{
    RowBox[{"\[CapitalUpsilon]ig", "[", "y", "]"}], "->", 
    RowBox[{
     RowBox[{"\[CapitalUpsilon]tg", "[", "y", "]"}], 
     RowBox[{"\[CapitalOmega]ig", "[", "y", "]"}]}]}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.984744644542767*^9, 3.984744843519796*^9}, {
  3.984755837865465*^9, 3.9847558820140867`*^9}, {3.984755926397765*^9, 
