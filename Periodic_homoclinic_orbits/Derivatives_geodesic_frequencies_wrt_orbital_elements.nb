Cell[BoxData[
 RowBox[{
  RowBox[{"dEgdr1gfun", "[", 
   RowBox[{"a_", ",", "p_", ",", "e_", ",", "xg_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
