 CellLabel->"In[22]:=",ExpressionUUID->"b6ae72ef-29bc-490b-aca5-f3eac3458ec0"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[CapitalUpsilon]ig", "\[Prime]",
     MultilineFunction->None], "[", "y", "]"}], "-", 
   RowBox[{
    RowBox[{"\[CapitalOmega]ig", "[", "y", "]"}], " ", 
    RowBox[{
     SuperscriptBox["\[CapitalUpsilon]tg", "\[Prime]",
      MultilineFunction->None], "[", "y", "]"}]}]}], 
  RowBox[{"\[CapitalUpsilon]tg", "[", "y", "]"}]]], "Output",
 CellChangeTimes->{{3.984744709971854*^9, 3.9847447370734653`*^9}, 
