Cell[BoxData[{
 RowBox[{
  FractionBox[
   RowBox[{"\[PartialD]", 
    SubscriptBox["\[CapitalUpsilon]", "ig"]}], 
   RowBox[{"\[PartialD]", "p"}]], "=", 
