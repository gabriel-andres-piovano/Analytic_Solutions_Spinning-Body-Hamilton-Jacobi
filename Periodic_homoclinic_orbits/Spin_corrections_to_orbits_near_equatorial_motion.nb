 RowBox[{"x", " ", "\[Equal]", "  ", 
  RowBox[{
   RowBox[{"Sign", "[", "\[ScriptCapitalL]", "]"}], 
   SqrtBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox["z", "1", "2"]}]]}]}]}], "DisplayFormula",
