  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
  3.931431791786874*^9}},ExpressionUUID->"b78244af-d490-4698-aa47-\
02e439249fc9"],

Cell[TextData[{
 "Note: the shift to the coordinate time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"4b924f2c-4ba0-4c76-b0e3-251228be237d"],
 ", and azimuthal velocities,",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"2d81ee3d-de5e-4b45-85ad-78c38845bf58"],
 ", are defined at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "e6602528-440d-4d94-9831-0a0856e8b03e"],
 " only if they are parametrized using the Mino-time \[Lambda]. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"9806adb7-d6bd-4573-a474-df50d4b08efa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"77367772-7281-4ef4-b1a6-37a4abcae89b"],
 " are not defined at when parametrized using the geodesic radial coordinate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "g"], TraditionalForm]],ExpressionUUID->
  "42de007a-3a64-416f-a3df-4dd10f5abbc4"],
 ". However, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"37544050-9120-49c3-b31d-08dbb1c7d79b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"016f35ed-7e75-4583-b471-d36b635932c0"],
 " are finite in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "5c29d915-e3a2-4338-a605-bc153b573da8"]
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
  3.967794596951537*^9, 
  3.967794597236643*^9}},ExpressionUUID->"88957694-5acf-4e8e-8e84-\
351d26028a58"],

Cell["\<\
The shift to the coordinate time velocity is finite near the periastron\
\>", "Text",
 CellChangeTimes->{{3.967782252604858*^9, 
  3.9677822919574347`*^9}},ExpressionUUID->"da9742bc-2cf1-4d58-8909-\
00959c933fae"],

