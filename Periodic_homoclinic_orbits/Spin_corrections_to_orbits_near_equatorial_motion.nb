Cell[CellGroupData[{

Cell["Spin corrections to the radial velocity", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.965066321283989*^9, 
  3.965066323806396*^9}, {3.967783824142536*^9, 
  3.9677838260001707`*^9}},ExpressionUUID->"34c6d1ed-9cbf-4c01-b7a0-\
b2166ce17a08"],

Cell[TextData[{
 "Note: the shift to the radial velocity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da1eaba9-0e25-4346-b3ee-3b41c9b1b108"],
 ", is defined at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39526cc2-44de-4192-ab42-91b4dc2dbe3f"],
 " only if it is parametrized using the Mino-time \[Lambda]. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6c053ac-5e7d-4dba-b4bb-51523330087a"],
 " is not defined at  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "469d3617-707e-43ef-a540-db368ba97937"],
 " when parametrized using the geodesic radial coordinate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "g"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6000fb39-7b6e-4a2a-815c-9f020cb86684"],
 ". However, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3cfef9b-3226-453c-be1b-3534a9381f78"],
 " is finite in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "614dd73f-0b0f-418e-a5fb-3df03ff3178f"]
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
