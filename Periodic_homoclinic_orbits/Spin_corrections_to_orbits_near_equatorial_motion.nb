Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"corrFEHom", "[", "\"\<\[Delta]tpar\>\"", "]"}], "[", "r2geo", 
     "]"}], ",", 
    RowBox[{
     RowBox[{"corrFEHom", "[", "\"\<\[Delta]tpar\>\"", "]"}], "[", 
     RowBox[{"r1geo", "-", 
