Cell[BoxData[{
 RowBox[{"p", "\[Equal]", 
  RowBox[{"2", 
   FractionBox[
    RowBox[{
     SubscriptBox["r", "1"], 
     SubscriptBox["r", "2"]}], 
    RowBox[{
     SubscriptBox["r", "1"], "+", 
     SubscriptBox["r", "2"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"e", "\[Equal]", " ", 
  FractionBox[
   RowBox[{
    SubscriptBox["r", "1"], "-", 
