Cell[CellGroupData[{

Cell["Spin corrections to the radial trajectories", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.9650663126486692`*^9, 
  3.965066314343925*^9}},ExpressionUUID->"7e9b4a44-3986-47a2-9ea3-\
1624037dc42e"],

Cell[TextData[{
 "Note: the correction to the radial motion, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],ExpressionUUID->
  "79dd6b67-b1d4-4620-a0ff-0e3d8e51fd8e"],
 ", is  defined at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "da68549c-a9a1-49dc-a939-3634e0aa99a3"],
 " only if they are parametrized using the Mino-time \[Lambda].  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],ExpressionUUID->
  "3838a2f0-6313-41f0-938c-138823cbf466"],
 " is not defined at when parametrized using the geodesic radial coordinate \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "g"], TraditionalForm]],ExpressionUUID->
  "889be09d-b94b-4ce9-9ca7-bacb94328319"],
 ". However,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],ExpressionUUID->
  "4fb238ba-a0f3-4d98-9572-83d0e140fda8"],
 " is finite in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "ce2c57d9-1c9b-4982-99bf-99b033f5cda7"]
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
  3.9677838662129393`*^9, 3.967783919213015*^9}, {3.967794517832097*^9, 
  3.967794567492484*^9}},ExpressionUUID->"44d0b950-fd78-4c58-9b3a-\
b609e59bf06a"],

