Cell[BoxData[{
 RowBox[{
  SubscriptBox["r", "1"], "\[Equal]", " ", 
  FractionBox["p", 
   RowBox[{"1", "-", "e"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["r", "2"], "\[Equal]", " ", 
  FractionBox["p", 
   RowBox[{"1", "+", "e"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["z", "1"], "\[Equal]", 
  SqrtBox[
   RowBox[{"1", "-", 
    SuperscriptBox["x", "2"]}]]}]}], "DisplayFormula",
 CellChangeTimes->{{3.798993074881772*^9, 3.7989931615194798`*^9}, 
   3.798993405684538*^9},ExpressionUUID->"34e4ef1b-ba24-4fa7-b01b-\
