Cell[CellGroupData[{

Cell["\<\
Spin corrections to the coordinate time and azimuthal trajectories\
\>", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
   3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
   3.931431791786874*^9}, 
   3.9761715339633636`*^9},ExpressionUUID->"192c9a4b-c2b9-4b05-8f3e-\
06d9f9b45e4a"],

Cell[TextData[{
 "Note: the shift to the coordinate time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"f4de07ca-553b-4c22-8867-aa98f8d111ae"],
 ", and azimuthal velocities,",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"254e6cc7-cffa-4f1b-8a7f-a83a0fc4e60f"],
 ", are diverging at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "a8350994-5b1a-42a7-9364-72f0b1318040"],
 " like their geodesic counterparts."
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
  3.967794596951537*^9, 3.967794597236643*^9}, {3.981784950226362*^9, 
  3.9817849957893887`*^9}},ExpressionUUID->"dc74d1cb-43cd-4534-bdc3-\
370816fe6d83"],

Cell[CellGroupData[{

