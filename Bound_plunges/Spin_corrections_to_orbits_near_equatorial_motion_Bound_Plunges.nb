Cell[CellGroupData[{

Cell["Spin corrections parallel component of the spin", "Subsection",
 CellChangeTimes->{{3.9308084943664083`*^9, 3.930808497278644*^9}, {
   3.930810329360127*^9, 3.9308104073450603`*^9}, 3.931432079803729*^9, 
   3.967727943020681*^9, 
   3.976180354042499*^9},ExpressionUUID->"35d145fc-d16c-4675-b4ce-\
a40a0a07deef"],

Cell[CellGroupData[{

Cell["Spin corrections to the radial trajectories", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.9650663126486692`*^9, 
  3.965066314343925*^9}},ExpressionUUID->"c703b3a9-eaec-4c10-9222-\
708074df9517"],

Cell[TextData[{
 "Note: the correction to the radial motion, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],ExpressionUUID->
  "43133a4b-6147-42df-8dc2-4b4d2b094c3e"],
 ", is  defined at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "06711e54-a63d-4316-8360-ec4b185ab1f7"],
 " only if they are parametrized using the Mino-time \[Lambda].  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],ExpressionUUID->
  "591b9139-4a2b-4ff1-afe0-cb7a167ea890"],
 " is not defined at when parametrized using the geodesic radial coordinate \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "g"], TraditionalForm]],ExpressionUUID->
  "104785c7-c571-468a-bdc5-a1b027623255"],
 ". However,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],ExpressionUUID->
  "5d48139e-5efb-480b-bb22-a900bd7f6a38"],
 " is finite in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "192efddd-00aa-4f8f-b45c-1dfcbe468120"]
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
  3.9677838662129393`*^9, 3.967783919213015*^9}, {3.967794517832097*^9, 
  3.967794567492484*^9}},ExpressionUUID->"a6095a19-f528-4c12-ac81-\
fd8d8a4fdb97"],

Cell["\<\
The correction to the radial motion is finite near the periastron\
\>", "Text",
 CellChangeTimes->{{3.967782252604858*^9, 3.9677822919574347`*^9}, {
  3.9677834186649857`*^9, 
  3.967783433637095*^9}},ExpressionUUID->"d519273a-e243-4f65-a1b1-\
36dd920bcebc"],

