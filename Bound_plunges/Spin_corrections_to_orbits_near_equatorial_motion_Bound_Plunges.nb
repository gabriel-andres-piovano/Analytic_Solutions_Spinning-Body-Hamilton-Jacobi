6b147ae6966f"],

Cell[BoxData[{
 RowBox[{"p", "\[Equal]", 
  RowBox[{"2", 
   FractionBox[
    RowBox[{
     SubscriptBox["r", "1"], 
     SubscriptBox["r", "2"]}], 
    RowBox[{
     SubscriptBox["r", "1"], "+", 
     SubscriptBox["r", "2"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"e", "\[Equal]", " ", 
  FractionBox[
   RowBox[{
    SubscriptBox["r", "1"], "-", 
    SubscriptBox["r", "2"]}], 
   RowBox[{
    SubscriptBox["r", "1"], "+", 
    SubscriptBox["r", "2"]}]]}], "\[IndentingNewLine]", 
 RowBox[{"x", " ", "\[Equal]", "  ", 
  RowBox[{
   RowBox[{"Sign", "[", "\[ScriptCapitalL]", "]"}], 
   SqrtBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox["z", "1", "2"]}]]}]}]}], "DisplayFormula",
 CellChangeTimes->{{3.7989931927598686`*^9, 3.798993206880576*^9}, {
