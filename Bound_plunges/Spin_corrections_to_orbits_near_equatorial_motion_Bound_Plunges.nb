  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"corrCritplunge", "[", " ", "\"\<vrg\>\"", "]"}], "[", "r", 
      "]"}], ",", 
