Cell[CellGroupData[{

Cell["\<\
Spin corrections to the coordinate time and azimuthal velocities\
\>", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
  3.931431791786874*^9}},ExpressionUUID->"5c9109b2-3a36-4fff-8e99-\
fc31ef58c157"],

Cell[TextData[{
 "Note: the shift to the coordinate time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"7a912bf3-4add-447f-923b-2f36dbbf0a62"],
 ", and azimuthal velocities,",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"269480d5-4b01-47ec-bd5e-2fa2ad8fa446"],
 ",  diverge as poles at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],ExpressionUUID->
  "35b39012-2af7-4ce8-99c3-1cfadced2bc1"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],ExpressionUUID->
  "b746d2b6-d15c-4b81-9152-690a13b76b2e"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "02720417-0a6e-41e6-bb53-3aedb489a77f"],
 "."
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
