Cell[CellGroupData[{

Cell["Spin corrections to the radial velocity", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.965066321283989*^9, 
  3.965066323806396*^9}, {3.967783824142536*^9, 
  3.9677838260001707`*^9}},ExpressionUUID->"30328cef-778b-4a26-9292-\
30e26c5df7fb"],

Cell[TextData[{
 "Note: the shift to the radial velocity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"57b70f56-375b-4362-add6-7ea559b58280"],
 ", is defined at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "6332ee73-8f45-4d29-8d3a-29cf2e86743f"],
 " only if it is parametrized using the Mino-time \[Lambda]. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"abeedd81-fd3a-4507-a6ba-1f39b6bbbce0"],
 " is not defined at  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "38cf076c-e4f1-4152-b6e4-2e110ba61d7b"],
 " when parametrized using the geodesic radial coordinate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "g"], TraditionalForm]],ExpressionUUID->
  "dfa3bc8f-6891-4624-9509-b58433bec5fa"],
 ". However, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"76f25559-c012-4037-92e2-0ee419c62851"],
 " is finite in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "74863553-d3af-40e5-9e62-259e8fc04aa3"]
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
  3.9677943790040693`*^9, 3.967794470381531*^9}, {3.9677945736275167`*^9, 
  3.967794577398787*^9}},ExpressionUUID->"9cde23ac-72f5-4fc4-b3e0-\
164eae69aee2"],

