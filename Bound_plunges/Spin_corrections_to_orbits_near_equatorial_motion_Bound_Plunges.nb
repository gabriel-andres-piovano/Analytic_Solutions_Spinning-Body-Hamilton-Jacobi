Cell[TextData[{
 "Spin correction to the polar motion. It diverges as a pole at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "6df5f4ad-908b-402b-a3bb-66eebb415d44"],
 " and logarithmically at the periastron."
}], "Text",
