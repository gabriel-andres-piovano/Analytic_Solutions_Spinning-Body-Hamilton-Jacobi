Cell[CellGroupData[{

Cell["\<\
Spin corrections to the coordinate time and azimuthal velocities\
\>", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
  3.931431791786874*^9}},ExpressionUUID->"70a16afc-bf20-454e-8f9c-\
942426c1a370"],

Cell[TextData[{
 "Note: the shift to the coordinate time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"248a2e88-d574-46fd-80cc-f7d0b8744c1c"],
 ", and azimuthal velocities,",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"2e866d35-e15a-4358-8834-ebc5cd6d30be"],
 ",  diverge as poles at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],ExpressionUUID->
  "34ca220e-6547-4576-858e-a6bfc2af1992"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],ExpressionUUID->
  "66dc6740-1293-484f-8984-a1c6ff7ce0ff"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "23ad410a-ede2-4d1f-9d31-f903910f353b"],
 "."
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
   3.967794596951537*^9, 3.967794597236643*^9}, 
   3.9817942806965427`*^9},ExpressionUUID->"56c62af8-f82c-434d-ba4d-\
19153d6b8c55"],

