7c9a4d23e590"],

Cell[TextData[{
 "The shifts to the coordinate time and azimuthal trajectories diverge as \
poles at the geodesics ISCO, at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],ExpressionUUID->
  "c1e880e0-6072-4b2c-acab-084b20636f4e"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],ExpressionUUID->
  "ffb8cf82-0760-4c19-99d3-246f6b3de78f"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "2f7e1992-c8aa-4519-9ed8-eee499cd2267"],
 "."
}], "Text",
 CellChangeTimes->{{3.967781048769547*^9, 3.967781084933509*^9}, {
  3.967781133401545*^9, 3.967781134224859*^9}, {3.967798197633613*^9, 
