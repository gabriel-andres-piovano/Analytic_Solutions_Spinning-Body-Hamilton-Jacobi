Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]ODECritplunge", "=", 
   RowBox[{"\[Phi]", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"Critplunge", "[", "\"\<d\[Phi]dr\>\"", "]"}], "[", "r", 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", 
           RowBox[{"r2", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"Critplunge", "[", "\"\<\[Phi]r\>\"", "]"}], "[", 
           RowBox[{"r2", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", "\[Phi]", 
       ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r2", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}]}], ";"}]], "Input",
