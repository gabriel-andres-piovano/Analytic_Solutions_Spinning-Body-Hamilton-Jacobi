Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]ODEPlungeBoundOrbit", "=", 
   RowBox[{"\[Phi]", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"PlungeBoundOrbit", "[", "\"\<d\[Phi]dr\>\"", "]"}], "[", 
           "r", "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", 
           RowBox[{"r3", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "5"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"PlungeBoundOrbit", "[", "\"\<\[Phi]r\>\"", "]"}], "[", 
           RowBox[{"r3", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "5"}], ")"}]}]}], "]"}]}]}], "}"}], ",", "\[Phi]", 
       ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r3", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "5"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}]}], ";"}]], "Input",
