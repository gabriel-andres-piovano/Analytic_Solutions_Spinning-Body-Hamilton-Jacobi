Cell["Numerical solutions equations of motion vs analytic results", \
"Subsection",
 CellChangeTimes->{{3.9308084943664083`*^9, 3.930808497278644*^9}, {
   3.930810329360127*^9, 3.9308104073450603`*^9}, 3.931432079803729*^9, 
   3.967727943020681*^9, 3.976391043470413*^9, 
   4.001664466514277*^9},ExpressionUUID->"0a97fd4f-bb81-48d8-88c8-\
14399fc8e09d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tODECritplunge", "=", 
   RowBox[{"t", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"t", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"Critplunge", "[", "\"\<dtdr\>\"", "]"}], "[", "r", 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"r2", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"Critplunge", "[", "\"\<tr\>\"", "]"}], "[", 
           RowBox[{"r2", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", "t", ",", 
       
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r2", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}]}], ";"}]], "Input",
