          RowBox[{
           RowBox[{"Plunge", "[", "\"\<tr\>\"", "]"}], "[", 
           RowBox[{"r1", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "5"}], ")"}]}]}], "]"}]}]}], "}"}], ",", "t", ",", 
       
       RowBox[{"{", 
