   4.001664466514277*^9},ExpressionUUID->"6f931ca1-6cd5-4044-9d9c-\
c99210639eed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tODECritplunge", "=", 
   RowBox[{"t", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"t", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"Critplunge", "[", "\"\<dtdr\>\"", "]"}], "[", "r", 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"r2", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"Critplunge", "[", "\"\<tr\>\"", "]"}], "[", 
           RowBox[{"r2", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", "t", ",", 
       
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r2", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
