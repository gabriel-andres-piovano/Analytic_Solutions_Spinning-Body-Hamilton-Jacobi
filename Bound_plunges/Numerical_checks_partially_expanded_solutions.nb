 RowBox[{
  RowBox[{"tODECritplunge", "=", 
   RowBox[{"t", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"t", "'"}], "[", "r", "]"}], "==", 
