Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]ODEISCOplunge", "=", 
   RowBox[{"\[Phi]", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"ISCOplunge", "[", "\"\<d\[Phi]dr\>\"", "]"}], "[", "r", 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", 
           RowBox[{"rISCO", "-", 
