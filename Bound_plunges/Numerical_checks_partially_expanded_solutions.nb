Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]ODEISCOplunge0rm", "=", 
   RowBox[{"\[Phi]", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"ISCOplunge", "[", "\"\<d\[Phi]dr\>\"", "]"}], "[", "r", 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", 
           RowBox[{"rm", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"ISCOplunge", "[", "\"\<\[Phi]r\>\"", "]"}], "[", 
           RowBox[{"rm", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", "\[Phi]", 
       ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"10", "^", 
