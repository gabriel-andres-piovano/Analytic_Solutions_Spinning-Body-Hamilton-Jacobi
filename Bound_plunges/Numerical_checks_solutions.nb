Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]tODEPlunge", "=", 
   RowBox[{"\[Delta]t", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]t", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"corrPlunge", "[", "\"\<\[Delta]vtpar\>\"", "]"}], "[",
                "r", "]"}], "-", 
              RowBox[{
               RowBox[{
               "corrPlunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
                "]"}], 
               RowBox[{
                RowBox[{"corrPlunge", "[", "\"\<vtg\>\"", "]"}], "[", "r", 
                "]"}]}]}], ")"}]}], "/", 
           RowBox[{
            RowBox[{"corrPlunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]t", "[", 
           RowBox[{"r1g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrPlunge", "[", "\"\<\[Delta]tpar\>\"", "]"}], "[", 
           RowBox[{"r1g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]t", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r1g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
