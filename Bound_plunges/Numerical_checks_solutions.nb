Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]tODEPBO", "=", 
   RowBox[{"\[Delta]t", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]t", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
               "corrPlungeBoundOrbit", "[", "\"\<\[Delta]vtpar\>\"", "]"}], "[",
                "r", "]"}], "-", 
              RowBox[{
               RowBox[{
               "corrPlungeBoundOrbit", 
                "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", "]"}], 
               RowBox[{
                RowBox[{"corrPlungeBoundOrbit", "[", "\"\<vtg\>\"", "]"}], "[",
                 "r", "]"}]}]}], ")"}]}], "/", 
           RowBox[{
            RowBox[{"corrPlungeBoundOrbit", "[", "\"\<vrg\>\"", "]"}], "[", 
            "r", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]t", "[", 
           RowBox[{"r3g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrPlungeBoundOrbit", "[", "\"\<\[Delta]tpar\>\"", "]"}],
            "[", 
           RowBox[{"r3g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]t", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r3g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "22"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
