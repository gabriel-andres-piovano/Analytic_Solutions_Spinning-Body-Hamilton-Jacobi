Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]rODEPlunge", "=", 
   RowBox[{"\[Delta]r", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]r", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corrPlunge", "[", "\"\<\[Delta]vrpar\>\"", "]"}], "[", 
             "r", "]"}], "/", 
            RowBox[{
             RowBox[{"corrPlunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
             "]"}]}], "-", 
           RowBox[{
           "corrPlunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]r", "[", 
           RowBox[{"r1g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrPlunge", "[", "\"\<\[Delta]rpar\>\"", "]"}], "[", 
           RowBox[{"r1g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]r", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"r1g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
