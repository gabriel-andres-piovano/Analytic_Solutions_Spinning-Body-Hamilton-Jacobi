Cell[TextData[{
 "The notebook presents numerical checks of the analytic solutions for \
trajectories available in ",
 StyleBox["AnalyticSpinOrbitsHamiltonJacobi",
  FontSlant->"Italic"],
 " against numerical solutions of the equations of motion in first order \
form.  ",
 StyleBox["See arXiv:2603.04682",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" ",
  FontColor->GrayLevel[0]],
 StyleBox[" (https://arxiv.org/abs/2603.04682 )",
