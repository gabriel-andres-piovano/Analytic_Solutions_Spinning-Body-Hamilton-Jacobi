   4.001664466514277*^9},ExpressionUUID->"18d8817d-e03a-45da-93e0-\
175283b74a83"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]rODEISCOPlunge", "=", 
   RowBox[{"\[Delta]r", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]r", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corrISCOplunge", "[", "\"\<\[Delta]vrpar\>\"", "]"}], "[",
              "r", "]"}], "/", 
            RowBox[{
             RowBox[{"corrISCOplunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
             "]"}]}], "-", 
           RowBox[{
           "corrISCOplunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]r", "[", 
           RowBox[{"rISCO", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrISCOplunge", "[", "\"\<\[Delta]rpar\>\"", "]"}], "[", 
           
           RowBox[{"rISCO", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]r", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"rISCO", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}], ",", 
       RowBox[{"PrecisionGoal", "->", "15"}], ",", 
       RowBox[{"AccuracyGoal", "->", "15"}]}], "]"}]}]}]}], ";"}]], "Input",
