Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]rODEPBO", "=", 
   RowBox[{"\[Delta]r", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]r", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "corrPlungeBoundOrbit", "[", "\"\<\[Delta]vrpar\>\"", "]"}], "[",
              "r", "]"}], "/", 
            RowBox[{
             RowBox[{"corrPlungeBoundOrbit", "[", "\"\<vrg\>\"", "]"}], "[", 
             "r", "]"}]}], "-", 
           RowBox[{
           "corrPlungeBoundOrbit", 
            "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]r", "[", 
           RowBox[{"r3g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrPlungeBoundOrbit", "[", "\"\<\[Delta]rpar\>\"", "]"}],
            "[", 
           RowBox[{"r3g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]r", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"r3g", "-", 
