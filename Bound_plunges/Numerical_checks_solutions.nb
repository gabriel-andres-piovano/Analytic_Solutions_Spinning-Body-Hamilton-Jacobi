Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]\[Phi]ODEPlunge", "=", 
   RowBox[{"\[Delta]\[Phi]", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]\[Phi]", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"corrPlunge", "[", "\"\<\[Delta]v\[Phi]par\>\"", "]"}],
                "[", "r", "]"}], "-", 
              RowBox[{
               RowBox[{
               "corrPlunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
                "]"}], 
               RowBox[{
                RowBox[{"corrPlunge", "[", "\"\<v\[Phi]g\>\"", "]"}], "[", 
                "r", "]"}]}]}], ")"}]}], "/", 
           RowBox[{
            RowBox[{"corrPlunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]\[Phi]", "[", 
           RowBox[{"r1g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrPlunge", "[", "\"\<\[Delta]\[Phi]par\>\"", "]"}], "[", 
           RowBox[{"r1g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]\[Phi]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r1g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}]}], ";"}]], "Input",
