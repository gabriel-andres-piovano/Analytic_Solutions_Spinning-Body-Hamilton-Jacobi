Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]\[Phi]ODEISCOplunge", "=", 
   RowBox[{"\[Delta]\[Phi]", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]\[Phi]", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
              "corrISCOplunge", "[", "\"\<\[Delta]v\[Phi]par\>\"", "]"}], "[",
               "r", "]"}], "-", 
