Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]tODECritplunge", "=", 
   RowBox[{"\[Delta]t", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]t", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"corrCritplunge", "[", "\"\<\[Delta]vtpar\>\"", "]"}], "[",
               "r", "]"}], "-", 
             RowBox[{
              RowBox[{
              "corrCritplunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
               "]"}], 
              RowBox[{
               RowBox[{"corrCritplunge", "[", "\"\<vtg\>\"", "]"}], "[", "r", 
               "]"}]}]}], ")"}], "/", 
           RowBox[{
            RowBox[{"corrCritplunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]t", "[", 
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrCritplunge", "[", "\"\<\[Delta]tpar\>\"", "]"}], "[", 
           
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]t", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r2g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}]}], ";"}]], "Input",
