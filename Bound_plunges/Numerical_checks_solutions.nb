              RowBox[{
              "corrISCOplunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
               "]"}], 
              RowBox[{
               RowBox[{"corrISCOplunge", "[", "\"\<v\[Phi]g\>\"", "]"}], "[", 
               "r", "]"}]}]}], ")"}], "/", 
           RowBox[{
            RowBox[{"corrISCOplunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]\[Phi]", "[", 
           RowBox[{"rISCO", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrISCOplunge", "[", "\"\<\[Delta]\[Phi]par\>\"", "]"}], 
           "[", 
           RowBox[{"rISCO", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]\[Phi]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
