Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]\[Phi]ODECritplunge", "=", 
   RowBox[{"\[Delta]\[Phi]", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]\[Phi]", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
              "corrCritplunge", "[", "\"\<\[Delta]v\[Phi]par\>\"", "]"}], "[",
               "r", "]"}], "-", 
             RowBox[{
              RowBox[{
              "corrCritplunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
               "]"}], 
              RowBox[{
               RowBox[{"corrCritplunge", "[", "\"\<v\[Phi]g\>\"", "]"}], "[", 
               "r", "]"}]}]}], ")"}], "/", 
           RowBox[{
            RowBox[{"corrCritplunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]\[Phi]", "[", 
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrCritplunge", "[", "\"\<\[Delta]\[Phi]par\>\"", "]"}], 
           "[", 
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]\[Phi]", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"rp", "+", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}], ",", 
         RowBox[{"r2g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "3"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}]}]}], ";"}]], "Input",
