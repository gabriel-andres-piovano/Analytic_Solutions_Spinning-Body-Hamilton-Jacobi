Cell[TextData[{
 "NOTE: the shift to the radial trajectory ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "[", 
    SubscriptBox["r", "g"], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29f137ac-4bbb-4118-a97d-5a0c67ba3333"],
 " in all plunges includes a term proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]\[CapitalUpsilon]", "r"], "/", 
    SubscriptBox["\[CapitalUpsilon]", "rg"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "050a8de0-c1fb-4122-a0fb-047bcc69c7d2"],
 " to ensure that the velocities and trajectories for critical plunge matches \
periodic orbits near the separatrix (e.g. in the limits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", 
     RowBox[{"3", "g"}]], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c3806bd-d4f3-4abe-b846-a7bf5a70e11f"],
 "). \nTo account for such a term, the ODEs are shifted by a term \
proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]\[CapitalUpsilon]", "r"], "/", 
    SubscriptBox["\[CapitalUpsilon]", "rg"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f484b32-7f92-43b8-87cc-a37953f0d6db"],
 "."
}], "Text",
 CellChangeTimes->{
