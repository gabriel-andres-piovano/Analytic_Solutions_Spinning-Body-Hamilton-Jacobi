 RowBox[{
  RowBox[{"\[Delta]rODECritPlunge", "=", 
   RowBox[{"\[Delta]r", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
