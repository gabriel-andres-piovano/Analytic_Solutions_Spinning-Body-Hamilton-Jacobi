Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]rODECritPlunge", "=", 
   RowBox[{"\[Delta]r", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]r", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corrCritplunge", "[", "\"\<\[Delta]vrpar\>\"", "]"}], "[",
              "r", "]"}], "/", 
            RowBox[{
             RowBox[{"corrCritplunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
             "]"}]}], "-", 
           RowBox[{
           "corrCritplunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]r", "[", 
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrCritplunge", "[", "\"\<\[Delta]rpar\>\"", "]"}], "[", 
           
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]r", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"r2g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
            RowBox[{"\"\<DifferenceOrder\>\"", "\[Rule]", "8"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"WorkingPrecision", "->", "24"}], ",", 
