            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]r", "[", 
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrCritplunge", "[", "\"\<\[Delta]rpar\>\"", "]"}], "[", 
           
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
