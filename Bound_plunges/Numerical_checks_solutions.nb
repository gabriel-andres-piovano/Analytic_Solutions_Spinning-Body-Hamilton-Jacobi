Cell[CellGroupData[{

Cell["Numerical solutions equations of motion vs analytic results", \
"Subsection",
 CellChangeTimes->{{3.9308084943664083`*^9, 3.930808497278644*^9}, {
   3.930810329360127*^9, 3.9308104073450603`*^9}, 3.931432079803729*^9, 
   3.967727943020681*^9, 3.976391043470413*^9, 
   4.00166445737659*^9},ExpressionUUID->"3aa7af8c-b303-4cfb-ba42-\
3a61383e7c99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]rODECritPlunge", "=", 
   RowBox[{"\[Delta]r", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]r", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corrCritplunge", "[", "\"\<\[Delta]vrpar\>\"", "]"}], "[",
              "r", "]"}], "/", 
            RowBox[{
             RowBox[{"corrCritplunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
             "]"}]}], "-", 
           RowBox[{
           "corrCritplunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]r", "[", 
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrCritplunge", "[", "\"\<\[Delta]rpar\>\"", "]"}], "[", 
           
           RowBox[{"r2g", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "10"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]r", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"r2g", "-", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TimeIntegration\>\"", "\[Rule]", 
