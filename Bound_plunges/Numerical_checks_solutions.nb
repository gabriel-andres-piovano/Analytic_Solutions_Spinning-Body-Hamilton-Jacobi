Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]tODEISCOplunge", "=", 
   RowBox[{"\[Delta]t", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]t", "'"}], "[", "r", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"corrISCOplunge", "[", "\"\<\[Delta]vtpar\>\"", "]"}], "[",
               "r", "]"}], "-", 
             RowBox[{
              RowBox[{
              "corrISCOplunge", "[", "\"\<\[Delta]\[CapitalUpsilon]rhat\>\"", 
               "]"}], 
              RowBox[{
               RowBox[{"corrISCOplunge", "[", "\"\<vtg\>\"", "]"}], "[", "r", 
               "]"}]}]}], ")"}], "/", 
           RowBox[{
            RowBox[{"corrISCOplunge", "[", "\"\<vrg\>\"", "]"}], "[", "r", 
            "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"\[Delta]t", "[", 
           RowBox[{"rISCO", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}], "==", 
          RowBox[{
           RowBox[{"corrISCOplunge", "[", "\"\<\[Delta]tpar\>\"", "]"}], "[", 
           
           RowBox[{"rISCO", "-", 
            RowBox[{"10", "^", 
             RowBox[{"(", 
              RowBox[{"-", "3"}], ")"}]}]}], "]"}]}]}], "}"}], ",", 
       "\[Delta]t", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", 
