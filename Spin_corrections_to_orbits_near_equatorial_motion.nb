Cell["Convention for EoM", "Subsection",
 CellChangeTimes->{{3.877700187447462*^9, 3.877700190136654*^9}, {
  3.888924676435042*^9, 
  3.888924688188291*^9}},ExpressionUUID->"a58ce164-9256-4cc2-9473-\
