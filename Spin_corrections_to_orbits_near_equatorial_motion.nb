Cell[TextData[{
 "PREREQUISITEs: the following packages are needed\n-  ",
 StyleBox["SpinOrbitsHamiltonJacobi ",
  FontSlant->"Italic"],
 "from the repo \
https://github.com/gabriel-andres-piovano/Spinning-Body-Hamilton-Jacobi. It \
computes the spin-corrections for generic orbits numerically, and is used for \
sanity checks.\n- ",
 StyleBox["KerrGeodesics",
  FontSlant->"Italic"],
 " from the BPToolkit. This package is needed to calculate the location of \
the geodesic separatrix."
}], "Text",
 CellChangeTimes->{
  3.935979797858018*^9, {3.93597987364237*^9, 3.935979887042235*^9}, {
