Cell[TextData[{
 "The notebook illustrates how to use the package ",
 StyleBox["AnalyticSpinOrbitsHamiltonJacobi",
  FontSlant->"Italic"],
 " , which provides the analytic spin corrections to nearly equatorial \
periodic and homoclinic orbits  ",
 StyleBox["See arXiv:",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" ",
  FontColor->GrayLevel[0]],
 StyleBox["2510.09597 (https://arxiv.org/abs/2510.09597 )",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.929334722204886*^9, 3.929334797609847*^9}, {
   3.929347181619532*^9, 3.929347183118011*^9}, {3.936264332948119*^9, 
