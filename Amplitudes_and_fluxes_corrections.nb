Cell[CellGroupData[{

Cell["Spin corrections parallel component of the spin ", "Subsection",
 CellChangeTimes->{{3.9308084943664083`*^9, 3.930808497278644*^9}, {
   3.930810329360127*^9, 3.9308104073450603`*^9}, 3.931432079803729*^9, 
   3.967727943020681*^9},ExpressionUUID->"6b58a355-e475-40ba-80c5-\
72361a441d49"],

Cell[CellGroupData[{

Cell["Spin corrections to the radial trajectories", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.9650663126486692`*^9, 
  3.965066314343925*^9}},ExpressionUUID->"7e9b4a44-3986-47a2-9ea3-\
1624037dc42e"],

Cell[TextData[{
 "Note: the correction to the radial motion, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79dd6b67-b1d4-4620-a0ff-0e3d8e51fd8e"],
 ", is  defined at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da68549c-a9a1-49dc-a939-3634e0aa99a3"],
 " only if they are parametrized using the Mino-time \[Lambda].  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3838a2f0-6313-41f0-938c-138823cbf466"],
 " is not defined at when parametrized using the geodesic radial coordinate \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "g"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "889be09d-b94b-4ce9-9ca7-bacb94328319"],
 ". However,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4fb238ba-a0f3-4d98-9572-83d0e140fda8"],
 " is finite in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
