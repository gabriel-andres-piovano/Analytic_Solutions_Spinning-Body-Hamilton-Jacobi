Cell[CellGroupData[{

Cell["Homoclinic orbits", "Section",
 CellChangeTimes->{{3.9309123811423492`*^9, 3.9309123851478863`*^9}, {
  3.9309920097703533`*^9, 3.930992014699868*^9}, {3.931429308568811*^9, 
  3.931429316050293*^9}, {3.9315320341425533`*^9, 3.931532041699854*^9}, {
  3.96511434913122*^9, 3.965114351045442*^9}, {3.9651206363654337`*^9, 
  3.965120638022759*^9}},ExpressionUUID->"138f1fca-3c35-4371-9a26-\
adfdc870c708"],

Cell[TextData[{
 "IMPORTANT NOTE: all the functions for the orbits take as input the mean \
anomalies ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "r"], TraditionalForm]],ExpressionUUID->
  "8fcfa53d-b227-45d8-8dd2-eabe32ce3953"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "z"], TraditionalForm]],ExpressionUUID->
  "01cb690a-5fe2-488c-9e8d-1966b07590a2"],
 ". The input of the following functions are:"
}], "Text",
 CellChangeTimes->{{3.931430236760071*^9, 3.931430261644573*^9}, {
  3.931531548875306*^9, 3.931531554752572*^9}, {3.9336722577269163`*^9, 
  3.9336722843746643`*^9}},ExpressionUUID->"135989f6-ebc3-423b-9aca-\
898509fc1b25"],

Cell[TextData[{
 "- primary spin \[OpenCurlyDoubleQuote]a\[CloseCurlyDoubleQuote]\n- \
semi-latus rectum \[OpenCurlyDoubleQuote]p\[CloseCurlyDoubleQuote]\n- \
eccentricity \[OpenCurlyDoubleQuote]e\[CloseCurlyDoubleQuote]\n- inclination \
\[OpenCurlyDoubleQuote]x\[CloseCurlyDoubleQuote] defined as  ",
 Cell[BoxData[
  RowBox[{"x", "=", 
   RowBox[{
    RowBox[{"Sign", "[", 
     SubscriptBox["L", "z"], "]"}], 
    SqrtBox[
     RowBox[{"1", "-", 
      SubsuperscriptBox["z", "1", "2"]}]]}]}]], "DisplayFormula",
  CellChangeTimes->{{3.7989931927598686`*^9, 3.798993206880576*^9}, {
   3.798993258511277*^9, 3.7989932882262516`*^9}, {3.798993321924838*^9, 
   3.7989933396319227`*^9}, {3.7989933739339075`*^9, 3.7989934023433447`*^9}},
  ExpressionUUID->"da94d32c-9376-4349-b9c1-e81ac2298d90"]
}], "Text",
 CellChangeTimes->{{3.933672291483739*^9, 3.93367234652733*^9}, {
