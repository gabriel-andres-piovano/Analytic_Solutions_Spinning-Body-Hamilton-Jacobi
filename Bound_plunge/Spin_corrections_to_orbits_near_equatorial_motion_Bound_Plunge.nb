Cell[BoxData[
 RowBox[{"MeridionalCritPlunge", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "+", 
           RowBox[{"\[Sigma]par", " ", 
            RowBox[{"\[Delta]rparHom", "[", "r", "]"}]}]}], ")"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "-", 
           RowBox[{"\[Sigma]ort", " ", 
            RowBox[{"\[Delta]zortHom", "[", "r", "]"}]}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "+", 
           RowBox[{"\[Sigma]par", " ", 
            RowBox[{"\[Delta]rparHom", "[", "r", "]"}]}]}], ")"}], 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "-", 
           RowBox[{"\[Sigma]ort", " ", 
            RowBox[{"\[Delta]zortHom", "[", "r", "]"}]}]}], "]"}]}]}], "}"}], 
      ",", 
      RowBox[{"{", 
