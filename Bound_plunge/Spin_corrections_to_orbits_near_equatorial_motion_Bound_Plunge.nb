30ab69e186b1"],

Cell[TextData[{
 "Note: the correction to the radial motion, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]r", "(", 
    SubscriptBox["r", "g"], ")"}], TraditionalForm]],ExpressionUUID->
  "67fb26a3-f04d-495d-9e28-63c15e1d8b9f"],
 ",  diverges as a pole at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0fae7afc-7289-4d75-a182-3bec5e7b9dc2"],
 "."
}], "Text",
