Cell[TextData[{
 "Spin correction to the polar motion. It diverges as a pole at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a46143c-caeb-48ff-8168-ecc9d5c4c1a1"],
 " and logarithmically at the periastron."
}], "Text",
