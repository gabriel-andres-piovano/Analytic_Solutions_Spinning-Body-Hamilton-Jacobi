  FormatType->TraditionalForm,ExpressionUUID->
  "1c171f4c-a1cb-4097-8243-0fd7ef410e30"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf53fcfe-5623-4ad4-8d6c-e02242c5b333"],
 "."
}], "Text",
