Cell[TextData[{
 "Comparison coordinate time and azimuthal trajectories. Homoclinic orbits \
have a different sign than critical plunges. Notice that both trajectories \
diverge logarithmically at the outer (inner) horizon ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ae0a1d8b-1dc3-4052-911d-ff1b37fac745"],
 "(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "-"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51d07975-5b34-4689-938e-baebf35ab9be"],
 ")"
}], "Text",
 CellChangeTimes->{{3.981793705865335*^9, 3.981793746058653*^9}, {
  3.9817940205285473`*^9, 
  3.9817941070367317`*^9}},ExpressionUUID->"5b34d8c7-e9ce-4412-9dad-\
e6b5efa54cef"],

