            RowBox[{"\[Delta]rparPlunge", "[", "r", "]"}]}]}], ")"}], 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "-", 
           RowBox[{"\[Sigma]ort", " ", 
            RowBox[{"\[Delta]zortPlunge", "[", "r", "]"}]}]}], "]"}]}]}], 
       "}"}], ",", 
