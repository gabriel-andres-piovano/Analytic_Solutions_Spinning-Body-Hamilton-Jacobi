Cell[CellGroupData[{

Cell["\<\
Spin corrections to the coordinate time and azimuthal velocities\
\>", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
  3.931431791786874*^9}},ExpressionUUID->"aed740e9-450c-4c8f-8eb6-\
0160d3d02924"],

Cell[TextData[{
 "Note: the shift to the coordinate time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"e537405b-4fe8-4073-85ca-e675946b2629"],
 ", and azimuthal velocities,",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"c401afd9-5bfa-4c6e-803b-c66906e8560b"],
 ",  diverge as poles at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4dacac77-fabf-45c6-9895-d88573d2d710"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69518a21-f0d3-4d61-afef-fba637ebc5cc"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b88e0980-298d-4593-b7ac-ab1c7c7c78a7"],
 "."
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
   3.967794596951537*^9, 3.967794597236643*^9}, 
   3.9817942806965427`*^9},ExpressionUUID->"77a4a06c-6969-4d87-a7db-\
df245c7dee18"],

