Cell[CellGroupData[{

Cell["\<\
Spin corrections to the coordinate time and azimuthal velocities\
\>", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
  3.931431791786874*^9}},ExpressionUUID->"415f4f4f-d2b3-4984-bccb-\
5940259f11e3"],

Cell[TextData[{
 "Note: the shift to the coordinate time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"bb862678-8034-40f8-aedc-9a640c6ac4ed"],
 ", and azimuthal velocities,",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"eeb4ff28-e0a4-41b5-9587-1a71600053bf"],
 ",  diverge as poles at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f349dc64-0cc1-457e-b841-071c6fb1da1a"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b914dbb1-699c-4446-b57d-7b865d8a4fed"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f470db89-c76a-4374-96d9-c62b581e783a"],
 "."
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
   3.967794596951537*^9, 3.967794597236643*^9}, 3.98178670171698*^9, 
   3.981787224928241*^9},ExpressionUUID->"48b8a106-4ffa-4ee4-ab94-\
8fac21152a7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
      "corrPlungeBoundOrbitDoubleRoot", "[", "\"\<\[Delta]vtpar\>\"", "]"}], "[",
       "r", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"aPlungeBoundOrbitDoubleRoot", "^", "2"}]}]], "+", 
        RowBox[{"1", "/", "100"}]}], ",", "r3gPlungeBoundOrbitDoubleRoot"}], 
      "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
      "corrNearPlungeBoundOrbitDoubleRoot", "[", "\"\<\[Delta]vtpar\>\"", 
       "]"}], "[", "r", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"aPlungeBoundOrbitDoubleRoot", "^", "2"}]}]], "+", 
        RowBox[{"1", "/", "100"}]}], ",", "r3gPlungeBoundOrbitDoubleRoot"}], 
      "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Dashed"}], "}"}]}]}], "]"}]}], "]"}]], "Input",
