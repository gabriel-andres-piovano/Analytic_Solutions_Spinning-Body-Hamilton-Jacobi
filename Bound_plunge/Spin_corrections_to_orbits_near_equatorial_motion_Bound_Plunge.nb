Cell[TextData[{
 "The shifts to the coordinate time and azimuthal trajectories diverge as \
poles at the geodesics ISCO, at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5b8d6a71-315a-43b0-bb6b-41fc6f9ea7cd"],
