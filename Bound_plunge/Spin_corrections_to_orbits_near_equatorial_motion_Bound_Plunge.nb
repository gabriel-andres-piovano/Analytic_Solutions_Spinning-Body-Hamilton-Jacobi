Cell[CellGroupData[{

Cell["Spin corrections to the radial velocity", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.965066321283989*^9, 
  3.965066323806396*^9}, {3.967783824142536*^9, 
  3.9677838260001707`*^9}},ExpressionUUID->"7d9c325b-23da-45da-8350-\
8d216526185c"],

Cell[TextData[{
 "Note: the shift to the radial velocity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"4bdcddfe-0441-4ce9-b91c-d19cdd8afae1"],
 ", is defined at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "b9ea2d97-6f8d-4939-b036-af70d45e1c51"],
 " only if it is parametrized using the Mino-time \[Lambda]. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"09499ad9-44bc-4838-93ff-58baf306e4d6"],
 " is not defined at  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "02099c6a-f9f0-4721-a651-be6dc9d99dcc"],
 " when parametrized using the geodesic radial coordinate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "g"], TraditionalForm]],ExpressionUUID->
  "cf28b26a-2514-4fd1-a409-b6aaea445194"],
 ". However, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]r", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"30dc8f39-fee3-487f-8b39-9b535c420e17"],
 " is finite in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "->", 
    SubscriptBox["r", 
     RowBox[{"2", "g"}]]}], TraditionalForm]],ExpressionUUID->
  "e32bf291-ced8-4eef-b4cb-e77007ed23d6"]
}], "Text",
 CellChangeTimes->{{3.9677834846793127`*^9, 3.967783803904956*^9}, {
  3.9677943790040693`*^9, 3.967794470381531*^9}, {3.9677945736275167`*^9, 
  3.967794577398787*^9}},ExpressionUUID->"f9bf109f-e884-4ef7-9185-\
6d4dc1c0fe3d"],

