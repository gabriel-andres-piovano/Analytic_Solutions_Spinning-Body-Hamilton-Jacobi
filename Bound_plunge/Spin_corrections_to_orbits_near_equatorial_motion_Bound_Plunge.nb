Cell[CellGroupData[{

Cell["\<\
Spin corrections to the coordinate time and azimuthal velocities\
\>", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
  3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
  3.931431791786874*^9}},ExpressionUUID->"02bfe22d-c414-4c4b-b19d-\
b7dd6b87e73f"],

Cell[TextData[{
 "Note: the shift to the coordinate time, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]t", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"5651511e-3676-4689-a09b-4fac9c7ff738"],
 ", and azimuthal velocities,",
 Cell[BoxData[
  FormBox[
   RowBox[{"d\[Delta]\[Phi]", "/", "d\[Lambda]"}], TraditionalForm]],
  ExpressionUUID->"9aa6cc7c-32b9-4e26-96a3-f1a8163bf594"],
 ",  diverge as poles at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "590165f3-106a-48b4-8c42-f1b475a8cd9e"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20d14078-7978-4d4c-a924-41db1b56655b"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c48a71f4-dbe8-4f37-8dbb-21ef23166a4d"],
 "."
}], "Text",
