Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"corrCritplunge", "[", " ", "\"\<trg\>\"", "]"}], "[", "r", 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", 
       FractionBox["pCritplunge", 
