Cell[CellGroupData[{

Cell["\<\
Spin corrections to the coordinate time and azimuthal trajectories\
\>", "Subsubsection",
 CellChangeTimes->{{3.9314301781279*^9, 3.9314302010790157`*^9}, {
   3.931430271922696*^9, 3.9314302816323023`*^9}, {3.9314317801834183`*^9, 
   3.931431791786874*^9}, {3.931431928154543*^9, 3.931431940308679*^9}, 
   3.967728175500999*^9, 
   3.976116447699127*^9},ExpressionUUID->"6d987ac3-7e7d-4735-9e24-\
9e4528d5281e"],

Cell[TextData[{
 "The shifts to the coordinate time and azimuthal trajectories diverge \
logarithmically at the periastron, as the corresponding geodesic \
trajectories, while  diverging as poles at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e37cf68-90ef-4711-8962-83a4388f5344"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "94c4e60c-4079-4958-a3bc-0eb4917b3019"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7df65a6f-624b-48f5-9fb3-c64a63820e95"],
 "."
}], "Text",
 CellChangeTimes->{{3.967781048769547*^9, 3.967781084933509*^9}, {
