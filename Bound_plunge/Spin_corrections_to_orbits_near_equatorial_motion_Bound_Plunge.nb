8613151ff1d2"],

Cell[TextData[{
 "The shifts to the coordinate time and azimuthal trajectories diverge as \
poles at the outer (inner) horizons ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b127c31-d1f6-4cc4-b93f-8272dcfa6533"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "-"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c0246d0-6121-450a-a13e-c2fba0bd8fae"],
 "), and at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "g"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c357c07-767b-4edf-92a4-e3beff385cad"],
 "."
}], "Text",
 CellChangeTimes->{{3.967781048769547*^9, 3.967781084933509*^9}, {
